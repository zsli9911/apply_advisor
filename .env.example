# ---- OpenAI ----
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ---- PostgreSQL + pgvector ----
# Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://advisor:advisor@localhost:5432/apply_advisor

# ---- Agent behaviour ----
MAX_AGENT_STEPS=8
RETRIEVAL_TOP_K=5

# ---- Embeddings ----
# Set to 1 to compute embeddings LOCALLY (deterministic, hash-based) instead of
# calling the embeddings API. Use this with chat providers that don't offer an
# embeddings endpoint (e.g. DeepSeek). Program recommendation is unaffected;
# only policy-document semantic ranking is weaker.
LOCAL_EMBEDDINGS=0

# ---- No-database mode (无数据库模式) ----
# Set to 1 to read universities/policies straight from data/*.json into memory,
# skipping Postgres + pgvector entirely. Great for a quick start — you only need
# an OpenAI key, no database. (IN_MEMORY=1 is an accepted alias.)
NO_DB=0

# ---- Dev / offline ----
# Set to 1 to run the agent + retrieval logic with a fake LLM/embedder,
# so you can smoke-test the whole pipeline without spending API credits.
MOCK_LLM=0
